{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --outDir dist --emptyOutDir",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://perigee-production-8f461d66.up.railway.app/api/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
