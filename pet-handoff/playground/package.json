{
  "name": "pet-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24", "npm": ">=11" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint:dialog": "node scripts/lint_dialog.mjs",
    "lint:seed": "node scripts/lint_dialog.mjs --partial ../dialog/seed.json",
    "budget": "node scripts/check_budget.mjs",
    "check": "tsc --noEmit && node scripts/lint_dialog.mjs && node scripts/lint_dialog.mjs --partial ../dialog/seed.json && vite build && node scripts/check_budget.mjs",
    "check:final": "tsc --noEmit && node scripts/lint_dialog.mjs --require && vitest run && vite build && node scripts/check_budget.mjs && node scripts/render.mjs",
    "test": "vitest run",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
