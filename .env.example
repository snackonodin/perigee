# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-long-random-string
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_KEY=
DATA_DIR=~/astro-data
DATABASE_URL=sqlite:///~/astro-data/db/astro.db
API_HOST=127.0.0.1
API_PORT=8000
# ESP receiver for on-demand Monitor sessions, e.g. /dev/cu.usbserial-XXXX (macOS) or COM3 (Windows)
MONITOR_SERIAL_PORT=
